rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Family Profiles Subcollection
      match /profiles/{profileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(profileId);
        allow delete: if isOwner(userId) && isValidId(profileId);

        // Medical Documents Subcollection
        match /documents/{documentId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidId(documentId);
          allow delete: if isOwner(userId) && isValidId(documentId);
        }

        // Reminders Subcollection
        match /reminders/{reminderId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidId(reminderId);
          allow delete: if isOwner(userId) && isValidId(reminderId);
        }
      }
    }
  }
}
